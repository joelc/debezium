<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>io.debezium</groupId>
        <artifactId>debezium-parent</artifactId>
        <version>3.4.0-SNAPSHOT</version>
        <relativePath>../debezium-parent/pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>debezium-binlog-lock-rewriter</artifactId>
    <name>Debezium BinaryLogClient Lock Rewriter</name>
    <packaging>jar</packaging>

    <description>
        Build-time ByteBuddy transformation of BinaryLogClient to add global lock support.
        Simply add this dependency BEFORE mysql-binlog-connector-java in your classpath.
        No Java agents, no JVM flags required.
    </description>

    <properties>
        <version.bytebuddy>1.15.10</version.bytebuddy>
    </properties>

    <dependencies>
        <!-- MySQL JDBC Driver for lock connection -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- SLF4J for logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- BinaryLogClient - we'll transform this -->
        <dependency>
            <groupId>io.debezium</groupId>
            <artifactId>mysql-binlog-connector-java</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ByteBuddy for build-time transformation -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${version.bytebuddy}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- ByteBuddy Maven Plugin - transforms classes at build time -->
            <plugin>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-maven-plugin</artifactId>
                <version>${version.bytebuddy}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>transform</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <transformations>
                        <transformation>
                            <plugin>io.debezium.binlog.lock.BinlogLockPlugin</plugin>
                        </transformation>
                    </transformations>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>io.debezium</groupId>
                        <artifactId>mysql-binlog-connector-java</artifactId>
                        <version>${version.mysql.binlog}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Unpack mysql-binlog-connector-java so we can transform it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-binlog-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.debezium</groupId>
                                    <artifactId>mysql-binlog-connector-java</artifactId>
                                    <version>${version.mysql.binlog}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/classes</outputDirectory>
                                    <includes>com/github/shyiko/mysql/binlog/BinaryLogClient.class</includes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
